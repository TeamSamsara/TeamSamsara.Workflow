{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src", "../engine/src", "../releases"],
  "exclude": ["src/**/*.test.ts", "../engine/src/**/*.test.ts", "../releases/**/*.test.ts"]
}
