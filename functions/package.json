{
  "name": "playbook-functions",
  "private": true,
  "description": "Playbook's server functions: notifications, reminders, email, signing out everywhere, keeping tasks in line with their workflows, and platform updates.",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --sourcemap --outfile=lib/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.7",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  }
}
