// File : /TeamSamsara.Workflow/firestore.rules
// Version : 1.8.0
// Latest commit: fix/group-leads-and-x-premium
// Author : Gerrah
// Purpose : Who may read and write what in Firestore. Everything is denied until
// a rule below allows it; each PR opens exactly what its feature needs, with a
// test in tests/rules for every rule.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // #region Helpers (used by the rules later PRs add)
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** The fields an update changes, compared with the stored document. */
    function changedFields() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // #endregion

    // #region Access: the same rules as core/access in the app
    function memberPath() {
      return /databases/$(database)/documents/members/$(request.auth.uid);
    }

    function memberRecord() {
      return get(memberPath());
    }

    /** Signed in with a member record that lets them in (Invited members activate on first sign-in). */
    function isActiveMember() {
      return isSignedIn()
        && exists(memberPath())
        && memberRecord().data.status in ["active", "invited"];
    }

    /** The roles that apply: every member also has Everyone. */
    function heldRoleIds() {
      return memberRecord().data.roleIds.concat(["everyone"]);
    }

    /**
     * Whether the signed-in member holds a permission, through any of their roles.
     * Reads the permission index in config/roles, so it costs one read however
     * many roles there are. Administrator allows everything.
     */
    function can(permission) {
      let grants = rolesGrants();
      return isActiveMember()
        && (grants.get("administrator", []).hasAny(heldRoleIds())
          || grants.get(permission, []).hasAny(heldRoleIds()));
    }

    /** The permission index (permission → role ids) as it is before this write. */
    function rolesGrants() {
      return get(/databases/$(database)/documents/config/roles).data.grants;
    }

    /**
     * The same check as can(), from values worked out once. Rules that check
     * every permission use this: Firestore stops after 1,000 steps per request.
     */
    function holds(grants, held, permission) {
      return grants.get("administrator", []).hasAny(held)
        || grants.get(permission, []).hasAny(held);
    }
    // #endregion

    // #region Workspace settings and roles
    function configPath(document) {
      return /databases/$(database)/documents/config/$(document);
    }

    match /config/{document} {
      allow read: if isActiveMember();
    }

    match /config/workspace {
      // Anyone may read it, signed in or not: before sign-in the app must know
      // whether to open first-time setup. It holds no private data.
      allow get: if true;
      allow create: if isSignedIn()
        && isValidWorkspace(request.resource.data)
        && request.resource.data.createdAt == request.time
        && isSetupBatch();
      allow update: if can("manageSettings")
        && isValidWorkspace(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /config/roles {
      allow create: if isSignedIn()
        && isSetupBatch()
        && isValidFirstRoles(request.resource.data);

      // Manage roles edits roles, but (like Discord) only hands out or takes
      // away permissions the editor holds; Administrator only by an
      // Administrator. Which roles sit above whose is kept by the app.
      allow update: if can("manageRoles")
        && isValidRoles(request.resource.data)
        && onlyHeldGrantsChange(rolesGrants(), heldRoleIds());
    }

    /** The shape every save keeps: Everyone exists and is never Administrator, someone still is. */
    function isValidRoles(data) {
      return data.keys().hasOnly(["roles", "grants"])
        && data.roles is map
        && data.grants is map
        && data.grants.keys().hasOnly(["administrator", "manageSettings",
          "manageMembers", "manageRoles", "manageWorkGroups", "editWorkflows",
          "planEvents", "createStandaloneTasks", "doAssignedTasks",
          "editAnyTask", "approveTasks", "reassignTasks", "viewAll"])
        && "everyone" in data.roles
        && !("administrator" in data.roles.everyone.permissions)
        && data.grants.get("administrator", []).size() > 0
        && !("everyone" in data.grants.get("administrator", []));
    }

    /** A permission's list of roles is unchanged, or the editor holds that permission. */
    function grantUnchangedOrHeld(grants, held, permission) {
      return request.resource.data.grants.get(permission, [])
          == grants.get(permission, [])
        || holds(grants, held, permission);
    }

    function onlyHeldGrantsChange(grants, held) {
      return grants.get("administrator", []).hasAny(held)
        || (grantUnchangedOrHeld(grants, held, "manageSettings")
          && grantUnchangedOrHeld(grants, held, "administrator")
          && grantUnchangedOrHeld(grants, held, "manageMembers")
          && grantUnchangedOrHeld(grants, held, "manageRoles")
          && grantUnchangedOrHeld(grants, held, "manageWorkGroups")
          && grantUnchangedOrHeld(grants, held, "editWorkflows")
          && grantUnchangedOrHeld(grants, held, "planEvents")
          && grantUnchangedOrHeld(grants, held, "createStandaloneTasks")
          && grantUnchangedOrHeld(grants, held, "doAssignedTasks")
          && grantUnchangedOrHeld(grants, held, "editAnyTask")
          && grantUnchangedOrHeld(grants, held, "approveTasks")
          && grantUnchangedOrHeld(grants, held, "reassignTasks")
          && grantUnchangedOrHeld(grants, held, "viewAll"));
    }

    // Same lengths as TextLimits in app/src/shared/validation/textLimits.ts.
    function isValidName(value) {
      return value is string && value.size() > 0 && value.size() <= 80;
    }

    function isValidWorkspace(data) {
      let required = ["name", "timeZone", "weekStartsOn", "timeFormat",
        "defaultTheme", "enabledPlatformIds", "createdAt"];
      // dateFormat and premiumPlatformIds came later, so older workspaces may not have them.
      return data.keys().hasOnly(required.concat(["dateFormat", "premiumPlatformIds"]))
        && data.keys().hasAll(required)
        && isValidName(data.name)
        && data.timeZone is string && data.timeZone.size() > 0
        && data.weekStartsOn in ["monday", "sunday"]
        && data.get("dateFormat", "weekdayMonthDay")
          in ["weekdayMonthDay", "monthDay", "dayMonth", "isoDate"]
        && data.timeFormat in ["12h", "24h"]
        && data.defaultTheme in ["light", "dark", "device"]
        // The same ids as PlatformCatalogue in app/src/features/platforms.
        && data.enabledPlatformIds is list
        && data.enabledPlatformIds.hasOnly(["x", "instagram", "youtube", "tiktok", "twitch", "bluesky", "threads", "linkedin", "facebook"])
        // Platforms where the workspace's account pays for more (only those that offer it).
        && data.get("premiumPlatformIds", []) is list
        && data.get("premiumPlatformIds", []).hasOnly(["x"])
        && data.createdAt is timestamp;
    }

    /**
     * First-time setup: there is no workspace yet, and this one write batch
     * creates it together with the roles and the signed-in person's own member
     * record, which holds a role that grants Administrator.
     */
    function isSetupBatch() {
      return !exists(configPath("workspace"))
        && existsAfter(configPath("workspace"))
        && existsAfter(memberPath())
        && existsAfter(configPath("roles"))
        && getAfter(memberPath()).data.roleIds.hasAny(
          getAfter(configPath("roles")).data.grants.get("administrator", []));
    }

    /** Everyone exists and never holds Administrator; at least one role does. */
    function isValidFirstRoles(data) {
      return data.keys().hasOnly(["roles", "grants"])
        && data.roles is map
        && data.grants is map
        && "everyone" in data.roles
        && !("administrator" in data.roles.everyone.permissions)
        && data.grants.get("administrator", []).size() > 0
        && !("everyone" in data.grants.get("administrator", []));
    }
    // #endregion

    // #region Members
    match /members/{memberId} {
      // A member reads their own record (to learn whether they have access),
      // and active members read everyone's (names, roles, groups).
      allow get: if isSelf(memberId);
      allow read: if isActiveMember();

      // A member's own writes: activating on first sign-in, and "last active".
      allow update: if isSelf(memberId)
        && (isActivatingSelf() || isRecordingLastActive());

      // Someone managing members, roles or groups changing another record.
      allow update: if isManagedChange();

      // First-time setup makes the first Admin; after that, invites.
      allow create: if (isSelf(memberId)
          && isSetupBatch()
          && isFirstAdminRecord(request.resource.data))
        || (can("manageMembers") && isInviteRecord(request.resource.data));

      // Members are never deleted: removing one keeps the record as Removed.
    }

    // #region Member changes made by others
    function memberFields() {
      return ["displayName", "email", "status", "roleIds", "workGroupIds",
        "timeZone", "invitedBy", "invitedAt", "joinedAt", "lastActiveAt"];
    }

    /** A permission the member gains from the change, which the editor must hold. */
    function gainIsHeld(grants, held, before, after, permission) {
      return !after.hasAny(grants.get(permission, []))
        || before.hasAny(grants.get(permission, []))
        || holds(grants, held, permission);
    }

    /**
     * Like Discord: you can't give anyone (yourself included) a permission you
     * don't have, through any role. Administrator is only given by
     * administrators, who may give anything.
     */
    function onlyHeldPermissionsGained(grants, held, before, after) {
      return grants.get("administrator", []).hasAny(held)
        || (gainIsHeld(grants, held, before, after, "administrator")
          && gainIsHeld(grants, held, before, after, "manageSettings")
          && gainIsHeld(grants, held, before, after, "manageMembers")
          && gainIsHeld(grants, held, before, after, "manageRoles")
          && gainIsHeld(grants, held, before, after, "manageWorkGroups")
          && gainIsHeld(grants, held, before, after, "editWorkflows")
          && gainIsHeld(grants, held, before, after, "planEvents")
          && gainIsHeld(grants, held, before, after, "createStandaloneTasks")
          && gainIsHeld(grants, held, before, after, "doAssignedTasks")
          && gainIsHeld(grants, held, before, after, "editAnyTask")
          && gainIsHeld(grants, held, before, after, "approveTasks")
          && gainIsHeld(grants, held, before, after, "reassignTasks")
          && gainIsHeld(grants, held, before, after, "viewAll"));
    }

    /** A new member from an invite: Invited, from the inviter, with the server's time. */
    function isInviteRecord(data) {
      return data.keys().hasOnly(memberFields())
        && data.keys().hasAll(memberFields())
        && data.displayName is string
        && data.displayName.size() <= 80
        && data.email is string
        && data.email.size() > 0
        && data.status == "invited"
        && data.roleIds is list
        && data.workGroupIds is list
        && onlyHeldPermissionsGained(rolesGrants(), heldRoleIds(), [], data.roleIds)
        && data.timeZone == null
        && data.invitedBy == request.auth.uid
        && data.invitedAt == request.time
        && data.joinedAt == null
        && data.lastActiveAt == null;
    }

    /**
     * Name, roles, groups and access, each needing its own permission:
     * names and access need Manage members; roles need Manage members or
     * Manage roles; groups need Manage members or Manage work groups. Only an
     * Administrator changes an Administrator's record.
     */
    function isManagedChange() {
      let before = resource.data;
      let after = request.resource.data;
      let changed = changedFields();
      let grants = rolesGrants();
      let held = heldRoleIds();
      let adminRoles = grants.get("administrator", []);
      return isActiveMember()
        && changed.hasOnly(["displayName", "roleIds", "workGroupIds",
          "status", "invitedBy", "invitedAt"])
        && (!changed.hasAny(["displayName", "status", "invitedBy", "invitedAt"])
          || holds(grants, held, "manageMembers"))
        && (!changed.hasAny(["roleIds"])
          || holds(grants, held, "manageMembers")
          || holds(grants, held, "manageRoles"))
        && (!changed.hasAny(["workGroupIds"])
          || holds(grants, held, "manageMembers")
          || holds(grants, held, "manageWorkGroups"))
        && after.displayName is string
        && after.displayName.size() <= 80
        && after.roleIds is list
        && after.workGroupIds is list
        && ((!before.roleIds.hasAny(adminRoles) && !after.roleIds.hasAny(adminRoles))
          || adminRoles.hasAny(held))
        && (!changed.hasAny(["roleIds"])
          || onlyHeldPermissionsGained(grants, held, before.roleIds, after.roleIds))
        && isAllowedStatusChange(before, after, changed);
    }

    function isAllowedStatusChange(before, after, changed) {
      return !changed.hasAny(["status", "invitedBy", "invitedAt"])
        // Turning access off, or back on (Active if they ever signed in, else Invited).
        || (!changed.hasAny(["invitedBy", "invitedAt"])
          && before.status in ["active", "invited", "disabled"]
          && (after.status == "disabled"
            || (after.status == "active" && before.joinedAt != null)
            || (after.status == "invited" && before.joinedAt == null)))
        // Removing: no roles and no groups left.
        || (!changed.hasAny(["invitedBy", "invitedAt"])
          && after.status == "removed"
          && after.roleIds.size() == 0
          && after.workGroupIds.size() == 0)
        // Inviting a removed member again.
        || (before.status == "removed"
          && after.status == "invited"
          && after.invitedBy == request.auth.uid
          && after.invitedAt == request.time);
    }
    // #endregion

    function isFirstAdminRecord(data) {
      let fields = ["displayName", "email", "status", "roleIds", "workGroupIds",
        "timeZone", "invitedBy", "invitedAt", "joinedAt", "lastActiveAt"];
      return data.keys().hasOnly(fields)
        && data.keys().hasAll(fields)
        && isValidName(data.displayName)
        && data.email == request.auth.token.email
        && data.status == "active"
        && data.roleIds is list
        && data.workGroupIds == []
        && data.timeZone == null
        && data.invitedBy == null
        && data.invitedAt == null
        && data.joinedAt == request.time
        && data.lastActiveAt == request.time;
    }

    /** First sign-in after an invite: Invited becomes Active, with the server's time. */
    function isActivatingSelf() {
      return resource.data.status == "invited"
        && request.resource.data.status == "active"
        && request.resource.data.joinedAt == request.time
        && request.resource.data.lastActiveAt == request.time
        && changedFields().hasOnly(["status", "joinedAt", "lastActiveAt"]);
    }

    /** An active member opening the app: only "last active" changes, to the server's time. */
    function isRecordingLastActive() {
      return resource.data.status == "active"
        && request.resource.data.lastActiveAt == request.time
        && changedFields().hasOnly(["lastActiveAt"]);
    }
    // #endregion

    // #region Work groups
    match /workGroups/{groupId} {
      allow read: if isActiveMember();
      allow create: if can("manageWorkGroups")
        && isValidWorkGroup(groupId, request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if can("manageWorkGroups")
        && isValidWorkGroup(groupId, request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if can("manageWorkGroups");
    }

    // Same limits as TextLimits and WorkGroupLimits in the app. leadIds and
    // links came later, so groups made before them may not have them.
    function isValidWorkGroup(groupId, data) {
      return data.keys().hasOnly(["name", "description", "createdAt", "leadIds", "links"])
        && data.keys().hasAll(["name", "description", "createdAt"])
        && isValidName(data.name)
        && data.description is string
        && data.description.size() <= 300
        && data.createdAt is timestamp
        && areValidLeads(groupId, data.get("leadIds", []))
        && areValidLinks(data.get("links", []));
    }

    /**
     * Up to 5 leads, each a current member of the group whose roles let them
     * approve or hand out tasks (Approve tasks, Reassign tasks or Administrator).
     */
    function areValidLeads(groupId, leadIds) {
      return leadIds is list
        && leadIds.size() <= 5
        && (leadIds.size() < 1 || canLead(groupId, leadIds[0]))
        && (leadIds.size() < 2 || canLead(groupId, leadIds[1]))
        && (leadIds.size() < 3 || canLead(groupId, leadIds[2]))
        && (leadIds.size() < 4 || canLead(groupId, leadIds[3]))
        && (leadIds.size() < 5 || canLead(groupId, leadIds[4]));
    }

    function canLead(groupId, memberId) {
      let path = /databases/$(database)/documents/members/$(memberId);
      let grants = rolesGrants();
      let held = exists(path) ? get(path).data.roleIds.concat(["everyone"]) : [];
      return exists(path)
        && get(path).data.status in ["active", "invited"]
        && get(path).data.workGroupIds.hasAny([groupId])
        && (held.hasAny(grants.get("administrator", []))
          || held.hasAny(grants.get("approveTasks", []))
          || held.hasAny(grants.get("reassignTasks", [])));
    }

    /** Up to 10 links, each a name and a web address (https). */
    function areValidLinks(links) {
      return links is list
        && links.size() <= 10
        && (links.size() < 1 || isValidLink(links[0]))
        && (links.size() < 2 || isValidLink(links[1]))
        && (links.size() < 3 || isValidLink(links[2]))
        && (links.size() < 4 || isValidLink(links[3]))
        && (links.size() < 5 || isValidLink(links[4]))
        && (links.size() < 6 || isValidLink(links[5]))
        && (links.size() < 7 || isValidLink(links[6]))
        && (links.size() < 8 || isValidLink(links[7]))
        && (links.size() < 9 || isValidLink(links[8]))
        && (links.size() < 10 || isValidLink(links[9]));
    }

    function isValidLink(link) {
      return link is map
        && link.keys().hasOnly(["label", "url"])
        && link.keys().hasAll(["label", "url"])
        && isValidName(link.label)
        && link.url is string
        && link.url.size() <= 2048
        && link.url.matches("https://[^ ]+");
    }
    // #endregion

    // Deny everything that no rule above allows.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
