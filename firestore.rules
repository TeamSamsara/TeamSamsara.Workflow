// File : /TeamSamsara.Workflow/firestore.rules
// Version : 1.5.0
// Latest commit: feature/work-groups
// Author : Gerrah
// Purpose : Who may read and write what in Firestore. Everything is denied until
// a rule below allows it; each PR opens exactly what its feature needs, with a
// test in tests/rules for every rule.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // #region Helpers (used by the rules later PRs add)
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** The fields an update changes, compared with the stored document. */
    function changedFields() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // #endregion

    // #region Access: the same rules as core/access in the app
    function memberPath() {
      return /databases/$(database)/documents/members/$(request.auth.uid);
    }

    function memberRecord() {
      return get(memberPath());
    }

    /** Signed in with a member record that lets them in (Invited members activate on first sign-in). */
    function isActiveMember() {
      return isSignedIn()
        && exists(memberPath())
        && memberRecord().data.status in ["active", "invited"];
    }

    /** The roles that apply: every member also has Everyone. */
    function heldRoleIds() {
      return memberRecord().data.roleIds.concat(["everyone"]);
    }

    /**
     * Whether the signed-in member holds a permission, through any of their roles.
     * Reads the permission index in config/roles, so it costs one read however
     * many roles there are. Administrator allows everything.
     */
    function can(permission) {
      let grants = get(/databases/$(database)/documents/config/roles).data.grants;
      return isActiveMember()
        && (grants.get("administrator", []).hasAny(heldRoleIds())
          || grants.get(permission, []).hasAny(heldRoleIds()));
    }
    // #endregion

    // #region Workspace settings and roles
    function configPath(document) {
      return /databases/$(database)/documents/config/$(document);
    }

    match /config/{document} {
      allow read: if isActiveMember();
    }

    match /config/workspace {
      // Anyone may read it, signed in or not: before sign-in the app must know
      // whether to open first-time setup. It holds no private data.
      allow get: if true;
      allow create: if isSignedIn()
        && isValidWorkspace(request.resource.data)
        && request.resource.data.createdAt == request.time
        && isSetupBatch();
      allow update: if can("manageSettings")
        && isValidWorkspace(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /config/roles {
      allow create: if isSignedIn()
        && isSetupBatch()
        && isValidFirstRoles(request.resource.data);

      // Manage roles edits roles, but (like Discord) only hands out or takes
      // away permissions the editor holds; Administrator only by an
      // Administrator. Which roles sit above whose is kept by the app.
      allow update: if can("manageRoles")
        && isValidRoles(request.resource.data)
        && onlyHeldGrantsChange();
    }

    /** The shape every save keeps: Everyone exists and is never Administrator, someone still is. */
    function isValidRoles(data) {
      return data.keys().hasOnly(["roles", "grants"])
        && data.roles is map
        && data.grants is map
        && data.grants.keys().hasOnly(["administrator", "manageSettings",
          "manageMembers", "manageRoles", "manageWorkGroups", "editWorkflows",
          "planEvents", "createStandaloneTasks", "doAssignedTasks",
          "editAnyTask", "approveTasks", "reassignTasks", "viewAll"])
        && "everyone" in data.roles
        && !("administrator" in data.roles.everyone.permissions)
        && data.grants.get("administrator", []).size() > 0
        && !("everyone" in data.grants.get("administrator", []));
    }

    /** A permission's list of roles is unchanged, or the editor holds that permission. */
    function grantUnchangedOrHeld(permission) {
      return request.resource.data.grants.get(permission, [])
          == resource.data.grants.get(permission, [])
        || can(permission);
    }

    function onlyHeldGrantsChange() {
      return grantUnchangedOrHeld("administrator")
        && grantUnchangedOrHeld("manageSettings")
        && grantUnchangedOrHeld("manageMembers")
        && grantUnchangedOrHeld("manageRoles")
        && grantUnchangedOrHeld("manageWorkGroups")
        && grantUnchangedOrHeld("editWorkflows")
        && grantUnchangedOrHeld("planEvents")
        && grantUnchangedOrHeld("createStandaloneTasks")
        && grantUnchangedOrHeld("doAssignedTasks")
        && grantUnchangedOrHeld("editAnyTask")
        && grantUnchangedOrHeld("approveTasks")
        && grantUnchangedOrHeld("reassignTasks")
        && grantUnchangedOrHeld("viewAll");
    }

    // Same lengths as TextLimits in app/src/shared/validation/textLimits.ts.
    function isValidName(value) {
      return value is string && value.size() > 0 && value.size() <= 80;
    }

    function isValidWorkspace(data) {
      let fields = ["name", "timeZone", "weekStartsOn", "timeFormat",
        "defaultTheme", "enabledPlatformIds", "createdAt"];
      return data.keys().hasOnly(fields)
        && data.keys().hasAll(fields)
        && isValidName(data.name)
        && data.timeZone is string && data.timeZone.size() > 0
        && data.weekStartsOn in ["monday", "sunday"]
        && data.timeFormat in ["12h", "24h"]
        && data.defaultTheme in ["light", "dark", "device"]
        && data.enabledPlatformIds is list
        && data.createdAt is timestamp;
    }

    /**
     * First-time setup: there is no workspace yet, and this one write batch
     * creates it together with the roles and the signed-in person's own member
     * record, which holds a role that grants Administrator.
     */
    function isSetupBatch() {
      return !exists(configPath("workspace"))
        && existsAfter(configPath("workspace"))
        && existsAfter(memberPath())
        && existsAfter(configPath("roles"))
        && getAfter(memberPath()).data.roleIds.hasAny(
          getAfter(configPath("roles")).data.grants.get("administrator", []));
    }

    /** Everyone exists and never holds Administrator; at least one role does. */
    function isValidFirstRoles(data) {
      return data.keys().hasOnly(["roles", "grants"])
        && data.roles is map
        && data.grants is map
        && "everyone" in data.roles
        && !("administrator" in data.roles.everyone.permissions)
        && data.grants.get("administrator", []).size() > 0
        && !("everyone" in data.grants.get("administrator", []));
    }
    // #endregion

    // #region Members
    match /members/{memberId} {
      // A member reads their own record (to learn whether they have access),
      // and active members read everyone's (names, roles, groups).
      allow get: if isSelf(memberId);
      allow read: if isActiveMember();

      // The only writes a member makes to their own record.
      allow update: if isSelf(memberId)
        && (isActivatingSelf() || isRecordingLastActive());

      // First-time setup: the person setting up becomes the first Admin.
      allow create: if isSelf(memberId)
        && isSetupBatch()
        && isFirstAdminRecord(request.resource.data);
    }

    function isFirstAdminRecord(data) {
      let fields = ["displayName", "email", "status", "roleIds", "workGroupIds",
        "timeZone", "invitedBy", "invitedAt", "joinedAt", "lastActiveAt"];
      return data.keys().hasOnly(fields)
        && data.keys().hasAll(fields)
        && isValidName(data.displayName)
        && data.email == request.auth.token.email
        && data.status == "active"
        && data.roleIds is list
        && data.workGroupIds == []
        && data.timeZone == null
        && data.invitedBy == null
        && data.invitedAt == null
        && data.joinedAt == request.time
        && data.lastActiveAt == request.time;
    }

    /** First sign-in after an invite: Invited becomes Active, with the server's time. */
    function isActivatingSelf() {
      return resource.data.status == "invited"
        && request.resource.data.status == "active"
        && request.resource.data.joinedAt == request.time
        && request.resource.data.lastActiveAt == request.time
        && changedFields().hasOnly(["status", "joinedAt", "lastActiveAt"]);
    }

    /** An active member opening the app: only "last active" changes, to the server's time. */
    function isRecordingLastActive() {
      return resource.data.status == "active"
        && request.resource.data.lastActiveAt == request.time
        && changedFields().hasOnly(["lastActiveAt"]);
    }
    // #endregion

    // #region Work groups
    match /workGroups/{groupId} {
      allow read: if isActiveMember();
      allow create: if can("manageWorkGroups")
        && isValidWorkGroup(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if can("manageWorkGroups")
        && isValidWorkGroup(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if can("manageWorkGroups");
    }

    // Same lengths as TextLimits in app/src/shared/validation/textLimits.ts.
    function isValidWorkGroup(data) {
      return data.keys().hasOnly(["name", "description", "createdAt"])
        && data.keys().hasAll(["name", "description", "createdAt"])
        && isValidName(data.name)
        && data.description is string
        && data.description.size() <= 300
        && data.createdAt is timestamp;
    }
    // #endregion

    // Deny everything that no rule above allows.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
