// File : /TeamSamsara.Workflow/firestore.rules
// Version : 1.1.0
// Latest commit: core/session
// Author : Gerrah
// Purpose : Who may read and write what in Firestore. Everything is denied until
// a rule below allows it; each PR opens exactly what its feature needs, with a
// test in tests/rules for every rule.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // #region Helpers (used by the rules later PRs add)
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** The fields an update changes, compared with the stored document. */
    function changedFields() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // #endregion

    // #region Members
    match /members/{memberId} {
      // A member reads their own record. Later rules let active members read everyone's.
      allow get: if isSelf(memberId);

      // The only writes a member makes to their own record.
      allow update: if isSelf(memberId)
        && (isActivatingSelf() || isRecordingLastActive());
    }

    /** First sign-in after an invite: Invited becomes Active, with the server's time. */
    function isActivatingSelf() {
      return resource.data.status == "invited"
        && request.resource.data.status == "active"
        && request.resource.data.joinedAt == request.time
        && request.resource.data.lastActiveAt == request.time
        && changedFields().hasOnly(["status", "joinedAt", "lastActiveAt"]);
    }

    /** An active member opening the app: only "last active" changes, to the server's time. */
    function isRecordingLastActive() {
      return resource.data.status == "active"
        && request.resource.data.lastActiveAt == request.time
        && changedFields().hasOnly(["lastActiveAt"]);
    }
    // #endregion

    // Deny everything that no rule above allows.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
